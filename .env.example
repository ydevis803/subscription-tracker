# Copy to .env and fill in before release. Shown on the Privacy, Terms, Support and Delete Account pages.
VITE_OWNER_NAME=
VITE_OWNER_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_LEGAL_JURISDICTION=
# Optional: public URL used in invitation links (defaults to the current origin).
VITE_APP_URL=
# Optional: store listing for the rating prompt (placeholder CTA until set).
VITE_STORE_URL=
# Optional: unlocks the owner-only store screenshot preview at /__store?key=… in production builds (always open in dev).
VITE_STORE_PREVIEW_KEY=
# Server: password reset delivery. Without SMTP_URL, emails are written to server/outbox/ (development only).
SMTP_URL=
MAIL_FROM=
